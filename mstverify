#!/usr/bin/env python3
import argparse
import json
import sys


def parse_param(raw: str) -> tuple[str, str]:
    if "=" not in raw:
        raise argparse.ArgumentTypeError(
            f"Invalid --param value '{raw}'. Expected format NAME=VALUE."
        )
    name, value = raw.split("=", 1)
    if not name:
        raise argparse.ArgumentTypeError(
            f"Invalid --param value '{raw}'. Parameter name cannot be empty."
        )
    return name, value


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="mstverify",
        description=(
            "Prepare mstverify CLI input with service name, operation, "
            "and input parameters."
        ),
    )
    parser.add_argument("--service-name", required=True, help="Target service name.")
    parser.add_argument("--operation", required=True, help="Operation to run.")
    parser.add_argument(
        "--param",
        action="append",
        default=[],
        type=parse_param,
        metavar="NAME=VALUE",
        help="Input parameter (repeatable). Example: --param tenantId=abc",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    params = {name: value for name, value in args.param}
    payload = {
        "serviceName": args.service_name,
        "operation": args.operation,
        "inputParameters": params,
    }
    print(json.dumps(payload, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
